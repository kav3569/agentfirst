{
  "name": "agentfirst",
  "version": "0.1.0",
  "description": "Reproducible AssemblyAI coding-agent integration benchmark",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "bench:prepare": "tsx scripts/prepare.ts",
    "bench:run": "tsx scripts/run.ts",
    "bench:calibrate": "tsx scripts/calibrate.ts",
    "bench:live": "tsx scripts/live.ts",
    "bench:generate": "tsx scripts/generate.ts",
    "bench:publish": "tsx scripts/publish-report.ts",
    "bench:pin-image": "tsx scripts/pin-image.ts",
    "bench:container-calibration": "tsx scripts/container-calibration.ts",
    "bench:import-calibration": "tsx scripts/import-calibration.ts",
    "bench:demo": "node --env-file=.env.local --import tsx scripts/transcribe-demo.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "lucide-react": "1.67.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "assemblyai": "4.42.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=24.21.0 <25"
  }
